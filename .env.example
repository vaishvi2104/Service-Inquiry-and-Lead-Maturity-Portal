# ==============================================================================
# Environment Configuration Template for Start-Up Sahay Portal
# Copy this file to .env and adjust values for your deployment environment.
# NEVER COMMIT ACTUAL PRODUCTION SECRETS OR SENSITIVE PASSWORDS TO VERSION CONTROL.
# ==============================================================================

# --- Django Core Security ---
# Generate a cryptographically secure key for production (e.g. via python -c "import secrets; print(secrets.token_urlsafe(50))")
SECRET_KEY=replace-with-a-local-development-secret-key-at-least-50-characters
DEBUG=False
ALLOWED_HOSTS=127.0.0.1,localhost,yourdomain.com

# --- Database Configuration ---
# Production PostgreSQL connection URL format:
# DATABASE_URL=postgresql://db_user:db_password@db_host:5432/db_name
# If DATABASE_URL is unset, the portal defaults to local SQLite for development:
DATABASE_URL=sqlite:///db.sqlite3

# Discrete database parameters (alternative to DATABASE_URL if preferred):
# DATABASE_ENGINE=django.db.backends.postgresql
# DATABASE_NAME=startupsahay_db
# DATABASE_USER=startupsahay_user
# DATABASE_PASSWORD=your_secure_db_password
# DATABASE_HOST=localhost
# DATABASE_PORT=5432

# --- Redis & Shared Cache Configuration (Optional, recommended for multi-worker production) ---
# REDIS_URL=redis://127.0.0.1:6379/1

# --- Reverse Proxy Configuration ---
# Set to True when running behind Nginx / AWS ALB / Render reverse proxy to trust forwarded client IPs
USE_X_FORWARDED_FOR=False

# --- CSRF Trusted Origins (Comma-separated, no wildcards in production) ---
# Example: https://portal.startupsahay.com,https://crm.startupsahay.com
CSRF_TRUSTED_ORIGINS=http://127.0.0.1,http://localhost

# --- Administrative User Initialization (setup_admin command) ---
# Provide values to initialize or verify the primary administrator account
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@startupsahay.com
ADMIN_PASSWORD=your_strong_admin_password_here

# --- Production Security & HTTPS Hardening ---
# Enable in production environments serving traffic over HTTPS
SESSION_COOKIE_SECURE=True
CSRF_COOKIE_SECURE=True
SECURE_SSL_REDIRECT=True
SECURE_HSTS_SECONDS=31536000
SECURE_HSTS_INCLUDE_SUBDOMAINS=True
SECURE_HSTS_PRELOAD=True

# --- Rate Limiting & Abuse Prevention ---
INQUIRY_RATE_LIMIT_MAX_REQUESTS=5
INQUIRY_RATE_LIMIT_WINDOW_SECONDS=600

# --- Login Brute-Force & Lockout Controls ---
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCKOUT_SECONDS=300
