# Environment Configuration Example for Start-Up Sahay Portal
# Copy this file to .env and adjust values for your local environment.
# DO NOT COMMIT .env TO VERSION CONTROL.

# Django Security
SECRET_KEY=replace-with-a-local-development-secret-key-at-least-50-characters
DEBUG=True
ALLOWED_HOSTS=127.0.0.1,localhost

# Database Configuration (Defaults to local SQLite if unset)
DATABASE_ENGINE=django.db.backends.sqlite3
DATABASE_NAME=db.sqlite3

# Production Security Flags (Set to True only when deploying under HTTPS)
SESSION_COOKIE_SECURE=False
CSRF_COOKIE_SECURE=False
SECURE_SSL_REDIRECT=False
SECURE_HSTS_SECONDS=0

# Rate Limiting & Abuse Prevention
INQUIRY_RATE_LIMIT_MAX_REQUESTS=5
INQUIRY_RATE_LIMIT_WINDOW_SECONDS=600
